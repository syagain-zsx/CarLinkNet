# 复制为 .env 即可生效（docker compose 会自动读取）。
# 国内云服务器建议启用以下镜像加速，避免拉取慢/超时。
# 若部署在海外或能直连官方源，保持注释即可。

# pip 镜像（清华）
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# PyTorch CPU 轮子镜像（阿里云，走 --find-links）
PYTORCH_FIND_LINKS=https://mirrors.aliyun.com/pytorch-wheels/cpu
# npm 镜像（淘宝 npmmirror）
NPM_REGISTRY=https://registry.npmmirror.com
